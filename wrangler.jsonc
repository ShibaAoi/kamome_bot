{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kamome-menu",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-06-18",
  "workers_dev": true,
  "vars": {
    "TIMEZONE": "Asia/Tokyo",
    "DEVELOPER_USER_IDS": "1100526193624743946"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kamome-menu-db",
      "database_id": "5a09253f-7270-471b-abdf-f8c08d6a66a2"
    }
  ]
}
